{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhiji-reading",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhiji-reading-db",
      "database_id": "c8ea2a9c-b4a5-4cb5-90d4-62c23260bcad",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "EDITOR_URL": "https://zhiji-reading-editor.li-siye-0123.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
